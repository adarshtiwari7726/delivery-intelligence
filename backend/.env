# ============================================================
# Delivery Intelligence - Environment Configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env or expose these values to the frontend.
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://100.107.158.103:3000

# ---- Database ----
DATABASE_URL=./database/database.sqlite

# ---- Marketplace ----
AMAZON_MARKETPLACE=amazon.in
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Active provider ----
# One of: mock | paapi | thirdparty
# "mock"       -> DEMO data only. Clearly labeled in the UI. No internet calls.
# "paapi"      -> Amazon Product Advertising / Creators API. Gives availability,
#                 price, Prime eligibility. Does NOT return a PIN-specific
#                 delivery date (Amazon does not expose that via PA-API).
# "thirdparty" -> A permitted third-party delivery-promise data provider that
#                 you have signed up with and agreed to that provider's terms.
#                 This is the only mode that can return a real PIN-level
#                 delivery date, because Amazon does not offer a first-party
#                 API for that. See README.md "Provider Options" section.
DELIVERY_PROVIDER=mock

# ---- Amazon Product Advertising API / Creators API credentials ----
# Register at https://affiliate-program.amazon.in/creatorsapi
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_HOST=webservices.amazon.in
PAAPI_REGION=eu-west-1

# ---- Third-party delivery-data provider ----
# Fill these in with whichever authorized provider you contract with.
# The adapter in backend/providers/thirdPartyProvider.js expects a simple
# JSON REST API; adjust the field mapping there to match your provider's
# actual response shape.
THIRDPARTY_API_BASE_URL=
THIRDPARTY_API_KEY=
THIRDPARTY_API_SECRET=

# ---- Rate limiting / queue defaults (can be overridden in Settings UI) ----
QUEUE_CONCURRENCY=3
QUEUE_REQUESTS_PER_MINUTE=60
QUEUE_RETRY_ATTEMPTS=3
QUEUE_TIMEOUT_MS=30000

# ---- Cache ----
CACHE_DURATION_MINUTES=30
